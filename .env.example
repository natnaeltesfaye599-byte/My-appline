# ─── Database ───────────────────────────────────────────────────────────────
# From Supabase → Project Settings → Database → "Transaction pooler" (port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# From Supabase → Project Settings → Database → "Direct connection" (port 5432)
# Used by Prisma for migrations only
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres"


# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate a strong secret: https://generate-secret.vercel.app/64
JWT_SECRET="replace-with-a-64-char-random-secret"

# ─── App ─────────────────────────────────────────────────────────────────────
# Your production URL (from Vercel), or http://localhost:3000 for local dev
NEXT_PUBLIC_APP_URL="https://myupline.vercel.app"

# ─── Optional ────────────────────────────────────────────────────────────────
# Set to "true" to allow demo logins in production (leave unset to disable)
# DEMO_MODE_ENABLED="true"
