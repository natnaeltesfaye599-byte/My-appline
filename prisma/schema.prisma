generator client {
  provider      = "prisma-client-js"
  // Include Linux binary for Vercel serverless deployment
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // For Supabase: use the "Transaction pooler" URL (port 6543) as DATABASE_URL
  // and the direct connection URL as DIRECT_URL (for migrations)
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TRAINER
  TEAM_LEADER
  MEMBER
}

enum MemberStatus {
  ACTIVE
  PENDING
  SUSPENDED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  PENDING_VERIFICATION
  EXPIRED
  CANCELLED
}

enum ContentType {
  PAGE
  NEWS
  FAQ
  ANNOUNCEMENT
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  REFRESH_TOKEN
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  users         User[]
  teams         Team[]
  plans         MembershipPlan[]
  courses       Course[]
  content       ContentItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String       @unique
  passwordHash   String
  fullName       String?
  phone          String?      @unique
  role           Role         @default(MEMBER)
  emailVerifiedAt DateTime?
  profileSetupCompleted Boolean @default(false)
  lastLoginAt    DateTime?
  profile        MemberProfile?
  authTokens     AuthToken[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AuthToken {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        AuthTokenType
  tokenHash   String        @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime      @default(now())

  @@index([userId, type, expiresAt])
}

model MemberProfile {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id])
  teamId         String?
  team           Team?        @relation(fields: [teamId], references: [id])
  firstName      String
  lastName       String
  phone          String?
  country        String?
  region         String?
  city           String?
  address        String?
  status         MemberStatus @default(PENDING)
  rank           String?
  referralCode   String       @unique
  referralsMade  Referral[]   @relation("Referrer")
  subscriptions  Subscription[]
  enrollments    Enrollment[]
  certificates   Certificate[]
  activities     ActivityLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Team {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  leaderId       String?
  members        MemberProfile[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Referral {
  id          String        @id @default(cuid())
  referrerId  String
  referrer    MemberProfile @relation("Referrer", fields: [referrerId], references: [id])
  leadName    String
  leadEmail   String
  code        String
  status      String        @default("NEW")
  convertedAt DateTime?
  createdAt   DateTime      @default(now())
}

model MembershipPlan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  price          Decimal      @db.Decimal(12, 2)
  durationDays   Int
  benefits       Json
  subscriptions  Subscription[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Subscription {
  id             String             @id @default(cuid())
  memberId       String
  member         MemberProfile      @relation(fields: [memberId], references: [id])
  planId         String
  plan           MembershipPlan     @relation(fields: [planId], references: [id])
  status         SubscriptionStatus @default(PENDING_VERIFICATION)
  startsAt       DateTime?
  expiresAt      DateTime?
  paymentProof   PaymentProof?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model PaymentProof {
  id                   String       @id @default(cuid())
  subscriptionId        String       @unique
  subscription          Subscription @relation(fields: [subscriptionId], references: [id])
  amount                Decimal      @db.Decimal(12, 2)
  transactionReference  String
  fileUrl               String?
  verifiedById          String?
  verifiedAt            DateTime?
  createdAt             DateTime     @default(now())
}

model Course {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  trainerId      String
  title          String
  description    String
  level          String
  status         String       @default("DRAFT")
  lessons        Lesson[]
  enrollments    Enrollment[]
  certificates   Certificate[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Lesson {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  title     String
  videoUrl  String?
  pdfUrl    String?
  order     Int
  quizzes   Quiz[]
  createdAt DateTime @default(now())
}

model Quiz {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  title     String
  questions Json
  passScore Int      @default(70)
  createdAt DateTime @default(now())
}

model Enrollment {
  id          String        @id @default(cuid())
  memberId    String
  member      MemberProfile @relation(fields: [memberId], references: [id])
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id])
  progress    Int           @default(0)
  completedAt DateTime?
  createdAt   DateTime      @default(now())

  @@unique([memberId, courseId])
}

model Certificate {
  id        String        @id @default(cuid())
  memberId  String
  member    MemberProfile @relation(fields: [memberId], references: [id])
  courseId  String
  course    Course        @relation(fields: [courseId], references: [id])
  code      String        @unique
  issuedAt  DateTime      @default(now())
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String?
  teamId      String?
  subject     String
  body        String
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
}

model ContentItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           ContentType
  locale         String       @default("en")
  title          String
  slug           String
  body           String
  status         String       @default("DRAFT")
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, locale, slug])
}

model ActivityLog {
  id        String         @id @default(cuid())
  memberId  String?
  member    MemberProfile? @relation(fields: [memberId], references: [id])
  actorId   String?
  action    String
  metadata  Json?
  createdAt DateTime       @default(now())
}
